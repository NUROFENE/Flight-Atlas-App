{
  "name": "flight-atlas",
  "productName": "Flight Atlas",
  "version": "6.0.73",
  "description": "Flight Atlas flight planning and simulator companion",
  "main": "main.js",
  "author": "Flight Atlas",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win nsis --x64",
    "dist": "electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "node-simconnect": "^4.2.1"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.flightatlas.desktop",
    "productName": "Flight Atlas",
    "asar": true,
    "files": [
      "main.js",
      "simconnect-bridge.js",
      "preload.js",
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "app/FlightAtlas.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Flight-Atlas-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "NUROFENE",
      "repo": "Flight-Atlas-App",
      "releaseType": "release"
    }
  }
}
